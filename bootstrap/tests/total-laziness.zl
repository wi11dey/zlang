(define `(if #t ,then _) then)
(define `(if #f _ ,else) else)
(define `(and ,left ,right) (if left right #f))
(define `(or ,left ,right) (if left #t right))
(define `(forever) (forever))

(define `(same zero zero) #t)
(define `(same zero (succ _)) #f)
(define `(same (succ _) zero) #f)
(define `(same (succ ,left) (succ ,right)) (same left right))

(define `(mix red blue) purple)
(define `(mix blue red) purple)
(define `(mix red red) red)
(define `(mix blue blue) blue)
(define `(is-purple purple) #t)

(define 'left-colour red)
(define `(right-colour) blue)
(define 'choose if)
(define `((const ,value) _) value)

(define 'ones (cons #t ones))
(define `(head (cons ,value _)) value)
(define `(test #t ,next) next)
(define `(test #f _) FAILED)

(test (if #t #t (forever))
  (test (if #f (forever) #t)
    (test (or #t (forever))
      (test (if (and #f (forever)) (forever) #t)
        (test (same (succ (succ zero)) (succ (succ zero)))
          (test (if (same (succ zero) (succ (succ zero))) (forever) #t)
            (test (is-purple (mix left-colour (right-colour)))
              (test (choose #t #t (forever))
                (test ((const #t) (forever))
                  (test (head ones) passed))))))))))
